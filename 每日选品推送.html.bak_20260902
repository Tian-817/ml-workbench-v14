<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>📊 甜の美客多选品工作台</title>
<style>
  *{ box-sizing:border-box; }
  html,body{ margin:0; padding:0; min-height:100%; }
  body{
    min-height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center;
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;
    background:linear-gradient(135deg,#e8f5e9 0%,#c8e6c9 50%,#a5d6a7 100%);
    color:#1a1a1a; padding:24px 18px; position:relative; overflow-x:hidden;
  }
  /* 装饰光晕（浅色） */
  body::before{ content:""; position:absolute; top:-100px; right:-80px; width:300px; height:300px;
    background:radial-gradient(circle,rgba(255,255,255,.6) 0%,transparent 70%); border-radius:50%; }
  body::after{ content:""; position:absolute; bottom:-120px; left:-100px; width:340px; height:340px;
    background:radial-gradient(circle,rgba(200,67,26,.08) 0%,transparent 70%); border-radius:50%; }
  .card{
    background:rgba(255,255,255,.75); border:1px solid rgba(255,255,255,.9); border-radius:22px;
    padding:36px 28px; max-width:440px; width:100%; text-align:center;
    backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px);
    box-shadow:0 12px 40px rgba(31,122,77,.12); position:relative; z-index:1;
  }
  .logo{ font-size:48px; margin-bottom:6px; line-height:1; }
  h1{ margin:0 0 8px; font-size:24px; font-weight:800; letter-spacing:.5px; color:#1a6b41; }
  .ver{
    display:inline-block; background:rgba(31,122,77,.12); color:#1a6b41; padding:3px 10px; border-radius:12px;
    font-size:11px; margin-bottom:14px; font-weight:700;
  }
  .ver.new{ background:linear-gradient(135deg,#e65100,#ff8a50); color:#fff; box-shadow:0 2px 8px rgba(230,81,0,.35); }
  .sub{ color:#4a4a4a; font-size:14px; margin:0 0 26px; line-height:1.6; }
  .features{
    display:flex; gap:8px; margin-bottom:22px; flex-wrap:wrap; justify-content:center;
  }
  .ft{ background:rgba(255,255,255,.7); border:1px solid rgba(31,122,77,.18); border-radius:10px;
    padding:6px 10px; font-size:11px; font-weight:600; color:#1a6b41; }
  .ft .em{ margin-right:3px; }
  .btn{
    display:flex; align-items:center; justify-content:center; gap:8px;
    text-decoration:none; padding:16px 22px; border-radius:16px; font-weight:700; font-size:16px;
    color:#1a6b41; background:#fff; border:1px solid rgba(31,122,77,.18); margin-top:12px;
    transition:transform .08s ease, background .2s, box-shadow .2s; box-shadow:0 6px 18px rgba(31,122,77,.12);
  }
  .btn:first-of-type{ margin-top:0; }
  .btn:hover{ background:#f0fff7; }
  .btn:active{ transform:scale(.97); }
  .btn .badge{
    background:#e65100; color:#fff; font-size:10px; padding:2px 7px; border-radius:8px;
    margin-left:4px; font-weight:700;
  }
  .btn.ml{ background:linear-gradient(135deg,#fff,#f0fff7); }
  .info-row{
    display:grid; grid-template-columns:repeat(3,1fr); gap:6px; margin:18px 0 4px;
  }
  .stat{
    background:rgba(255,255,255,.65); border:1px solid rgba(31,122,77,.15);
    border-radius:10px; padding:8px 4px; text-align:center;
  }
  .stat .v{ font-size:16px; font-weight:800; color:#1a6b41; line-height:1.1; }
  .stat .l{ font-size:9px; color:#6c7270; margin-top:2px; }
  .tip{ margin-top:24px; font-size:12px; color:#4a4a4a; line-height:1.7; }
  .foot{ margin-top:12px; font-size:10px; color:#888; letter-spacing:.3px; }
  .date-tag{
    display:inline-block; background:rgba(31,122,77,.1); color:#1a6b41; padding:2px 8px; border-radius:6px;
    font-size:10px; margin-left:6px; font-family:monospace;
  }
</style>
</head>
<body>
  <div class="card">
    <div class="logo">📊</div>
    <h1>甜の美客多选品工作台</h1>
    <span class="ver new">v14 · 重写版</span>
    <span class="date-tag">2026-08-28</span>

    <p class="sub">
      行业情报中心 · 双站今日推送<br>
      节日日历 · 趋势热词 · 自动化监控
    </p>

    <div class="features">
      <span class="ft"><span class="em">📅</span>节日备货</span>
      <span class="ft"><span class="em">🔥</span>预测爆款</span>
      <span class="ft"><span class="em">📰</span>行业快讯</span>
      <span class="ft"><span class="em">✦</span>双站推送</span>
      <span class="ft"><span class="em">📚</span>平台知识</span>
      <span class="ft"><span class="em">⏰</span>每日自动化</span>
    </div>

    <a class="btn ml" href="手机工作台.html">📲 手机工作台（推荐）<span class="badge">NEW</span></a>
    <a class="btn" href="工作台.html">💻 电脑工作台（完整版）</a>

    <div class="info-row">
      <div class="stat">
        <div class="v">5</div>
        <div class="l">情报板块</div>
      </div>
      <div class="stat">
        <div class="v">100+</div>
        <div class="l">双站候选词</div>
      </div>
      <div class="stat">
        <div class="v">5</div>
        <div class="l">每日自动化</div>
      </div>
    </div>

    <p class="tip">
      🇲🇽 墨站 08:45 · 🇧🇷 巴站 09:15 推送<br>
      每日 09:20 自动部署 · 历史归档可回看任意日期
    </p>
    <p class="foot">本工作台由 WorkBuddy 维护 · 仅作信息分享</p>
  </div>
</body>
</html>
